  <!-- OmniPad mark: generic gamepad inside a tilted orbit with three "device" dots.
       Drawn in a 512x512 box centred on (256,272). Reused by every asset. -->
  <defs>
    <linearGradient id="orbit" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#22E1FF"/>
      <stop offset="0.5" stop-color="#7B6CFF"/>
      <stop offset="1" stop-color="#FF4FD8"/>
    </linearGradient>
    <linearGradient id="body" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FFFFFF"/>
      <stop offset="1" stop-color="#D9DDF5"/>
    </linearGradient>
    <clipPath id="front" clipPathUnits="userSpaceOnUse">
      <rect x="0" y="272" width="512" height="240"/>
    </clipPath>
    <filter id="glow" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="6" result="b"/>
      <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>

  <!-- orbit, back half -->
  <g transform="rotate(-16 256 272)" filter="url(#glow)">
    <ellipse cx="256" cy="272" rx="214" ry="92" fill="none" stroke="url(#orbit)" stroke-width="11" opacity="0.55"/>
  </g>

  <!-- gamepad body (generic silhouette) -->
  <path d="M150 198 C 120 198 100 222 92 258 L 72 352 C 65 390 92 412 118 394 L 166 350
           C 210 330 302 330 346 350 L 394 394
           C 420 412 447 390 440 352 L 420 258 C 412 222 392 198 362 198 C 330 190 182 190 150 198 Z"
        fill="url(#body)"/>
  <!-- d-pad -->
  <g fill="#2A2266">
    <rect x="162" y="232" width="22" height="64" rx="5"/>
    <rect x="141" y="253" width="64" height="22" rx="5"/>
  </g>
  <!-- face buttons -->
  <circle cx="340" cy="238" r="12" fill="#22E1FF"/>
  <circle cx="366" cy="264" r="12" fill="#FF4FD8"/>
  <circle cx="314" cy="264" r="12" fill="#7B6CFF"/>
  <circle cx="340" cy="290" r="12" fill="#2A2266"/>
  <!-- centre buttons -->
  <rect x="226" y="236" width="24" height="10" rx="5" fill="#2A2266" opacity="0.7"/>
  <rect x="262" y="236" width="24" height="10" rx="5" fill="#2A2266" opacity="0.7"/>
  <!-- sticks -->
  <circle cx="210" cy="304" r="20" fill="#2A2266"/>
  <circle cx="302" cy="304" r="20" fill="#2A2266"/>
  <circle cx="210" cy="304" r="9" fill="#3D338A"/>
  <circle cx="302" cy="304" r="9" fill="#3D338A"/>

  <!-- orbit, front half + device dots -->
  <g transform="rotate(-16 256 272)" filter="url(#glow)">
    <ellipse cx="256" cy="272" rx="214" ry="92" fill="none" stroke="url(#orbit)" stroke-width="11" clip-path="url(#front)"/>
    <circle cx="74" cy="320" r="15" fill="#22E1FF"/>
    <circle cx="256" cy="364" r="15" fill="#7B6CFF"/>
    <circle cx="440" cy="320" r="15" fill="#FF4FD8"/>
  </g>
